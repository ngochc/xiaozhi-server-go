{
    "swagger": "2.0",
    "info": {
        "description": "Xiaozhi Server, including OTA, Vision, and Management APIs",
        "title": "Xiaozhi Server API Documentation",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api",
    "paths": {
        "/ota/": {
            "get": {
                "description": "Get OTA service status and WebSocket address for device query",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "OTA"
                ],
                "summary": "Get OTA status",
                "responses": {
                    "200": {
                        "description": "OTA interface is running, websocket address: ws://...",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "description": "Upload device info to get latest firmware version and download URL",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "OTA"
                ],
                "summary": "Upload device info to get latest firmware",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device ID",
                        "name": "device-id",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Request body",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/ota.OtaRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ota.OtaFirmwareResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/ota.ErrorResponse"
                        }
                    }
                }
            },
            "options": {
                "description": "Handle OPTIONS preflight request for OTA endpoints, returns 200",
                "consumes": [
                    "*/*"
                ],
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "OTA"
                ],
                "summary": "OTA preflight request",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/ota_bin/{filename}": {
            "get": {
                "description": "Download OTA firmware by filename",
                "produces": [
                    "application/octet-stream"
                ],
                "tags": [
                    "OTA"
                ],
                "summary": "Download OTA firmware file",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Firmware filename",
                        "name": "filename",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "File stream"
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/ota.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "ota.ErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Missing device-id"
                },
                "success": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "ota.OtaFirmwareResponse": {
            "type": "object",
            "properties": {
                "firmware": {
                    "type": "object",
                    "properties": {
                        "url": {
                            "type": "string",
                            "example": "/ota_bin/1.0.3.bin"
                        },
                        "version": {
                            "type": "string",
                            "example": "1.0.3"
                        }
                    }
                },
                "server_time": {
                    "type": "object",
                    "properties": {
                        "timestamp": {
                            "type": "integer",
                            "example": 1688443200000
                        },
                        "timezone_offset": {
                            "type": "integer",
                            "example": 480
                        }
                    }
                },
                "websocket": {
                    "type": "object",
                    "properties": {
                        "url": {
                            "type": "string",
                            "example": "wss://example.com/ota"
                        }
                    }
                }
            }
        },
        "ota.OtaRequest": {
            "type": "object",
            "properties": {
                "application": {
                    "type": "object",
                    "properties": {
                        "version": {
                            "type": "string",
                            "example": "1.0.0"
                        }
                    }
                }
            }
        }
    }
}